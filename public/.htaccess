RewriteRule ^ar/blog/clean-special-characters/?$ /ar/blog/clean-arabic-database-sql/ [L,R=301]
RewriteRule ^ar/blog/fix-arabic-photoshop/?$ /ar/blog/fix-photoshop-arabic-text/ [L,R=301]
RewriteRule ^ar/blog/fix-illustrator-arabic/?$ /ar/blog/fix-premiere-illustrator-arabic/ [L,R=301]
